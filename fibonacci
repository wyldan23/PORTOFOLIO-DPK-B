#include <iostream>
using namespace std;

int fibonacci(int n) {
    if (n == 0)
        return 0;
    else if (n == 1)
        return 1;
    else
        return fibonacci(n - 1) + fibonacci(n - 2);
}

int main() {
    int n;

    cout << "Input number: ";
    cin >> n;

    cout << "Fibonacci sequence:" << endl;

    for (int i = 0; i < n; i++) {
        cout << fibonacci(i);

        if (i < n - 1)
            cout << ", ";
    }

    cout << endl;

    return 0;
}
